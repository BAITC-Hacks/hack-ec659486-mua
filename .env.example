# Скопируйте в .env:  cp .env.example .env
# Файл .env не коммитится (см. .gitignore).

# ---------- LLM ----------
# Ключ OpenAI. Нужен только при LLM_MODE=live.
OPENAI_API_KEY=
# Модель для Responses API (можно поменять без правки кода).
# gpt-5.6-luna — дешёвая и быстрая; для извлечения функций и заключения — gpt-5.6-terra.
OPENAI_MODEL=gpt-5.6-luna
# live | mock. Режим выбирается ТОЛЬКО явно, тихого перехода live -> mock нет.
# mock: ответы из backend/app/mocks/<name>.json, ключ не нужен — это штатный способ
#       проверки проекта без личных аккаунтов (Положение 5.6.6).
# live с пустым OPENAI_API_KEY: приложение не стартует и скажет, что делать.
LLM_MODE=mock

# ---------- Backend ----------
# Список origin'ов через запятую, которым разрешён CORS.
CORS_ORIGINS=http://localhost:3000
APP_VERSION=0.1.0

# ---------- Frontend ----------
# Адрес API для браузера (инлайнится в бандл при сборке).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ОргДифф

# DOMAIN нужен только для docker-compose.prod.yml (VPS + Caddy).
DOMAIN=

# ---------- Fallback-провайдер (по желанию) ----------
# NVIDIA NIM, OpenAI-совместимый endpoint: https://build.nvidia.com -> ключ
NVIDIA_API_KEY=
